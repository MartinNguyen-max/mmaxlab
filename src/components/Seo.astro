---
import { SITE } from '../config';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string;
  noindex?: boolean | undefined;
}

const { title, description = SITE.description, image = '/og.png', noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.author}`;
// build.format 'file' gives /index.html and /about.html; canonical URLs are clean.
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(cleanPath || '/', Astro.site ?? SITE.url).href;
const imageUrl = new URL(image, Astro.site ?? SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      author: { '@id': `${SITE.url}/#person` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE.url}/#person`,
      name: SITE.author,
      jobTitle: SITE.jobTitle,
      url: SITE.url,
      address: { '@type': 'PostalAddress', addressLocality: 'Aarhus', addressCountry: 'DK' },
      sameAs: [SITE.github, SITE.linkedin],
    },
  ],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="author" content={SITE.author} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="M.MaxLab: a glowing orange black hole in deep space." />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
