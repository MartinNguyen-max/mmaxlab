---
import { SITE } from '../config';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/#planet', label: 'Planet' },
  { href: '/#projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
---

<header class="site-header">
  <div class="bar container">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <Logo size={30} />
      <span class="brand-name" aria-hidden="true">
        M<span class="dot">.</span>MaxLab
      </span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={path === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a class="icon-link" href={SITE.github} aria-label="GitHub profile">
            <Icon name="github" size={18} />
          </a>
        </li>
        <li>
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
  }

  /* Glass background fades in once the page scrolls (native scroll-driven animation). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header {
        animation: header-glass linear both;
        animation-timeline: scroll(root);
        animation-range: 0 30vh;
      }
    }
  }

  @supports not (animation-timeline: scroll()) {
    .site-header {
      background: var(--c-glass);
      backdrop-filter: blur(14px);
    }
  }

  @keyframes header-glass {
    to {
      background: var(--c-glass);
      backdrop-filter: blur(14px) saturate(1.4);
      border-bottom-color: var(--c-line);
    }
  }

  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-name {
    font-size: 1.05rem;
  }

  .dot {
    color: var(--c-accent);
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--c-fg);
  }

  .icon-link {
    width: 2.5rem;
    justify-content: center;
    padding: 0;
  }

  @media (width < 30rem) {
    .brand-name {
      display: none;
    }
  }
</style>
