---
/**
 * Fixed WebGL background, persisted across page navigations.
 * Pages opt in to the black-hole intro by rendering an element with [data-launch].
 */
---

<canvas class="cosmos" aria-hidden="true" transition:persist="cosmos"></canvas>

<script>
  import { Cosmos } from '../scripts/cosmos/cosmos';
  import { updateTelemetry } from '../scripts/telemetry';

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.cosmos');
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');
  const finePointer = matchMedia('(pointer: fine)');

  let cosmos: Cosmos | undefined;
  try {
    if (canvas) cosmos = new Cosmos(canvas, { animate: motion.matches });
  } catch {
    document.documentElement.classList.add('no-webgl');
  }

  let launchEnd = 1;
  let hasLaunch = false;
  let lastWidth = innerWidth;

  // The canvas is sized to the *large* viewport (100lvh), which does not change when a phone's
  // address bar slides in and out. Measuring against it keeps the scene from jumping mid-scroll.
  const viewportHeight = () => canvas?.clientHeight || innerHeight;

  function measure() {
    const launch = document.querySelector<HTMLElement>('[data-launch]');
    hasLaunch = launch !== null;
    if (launch) {
      const rect = launch.getBoundingClientRect();
      launchEnd = Math.max(1, rect.bottom + scrollY - viewportHeight());
    }
    // Centre the black hole on the focus element (the hero title) as laid out at the top of the page.
    const focus = document.querySelector<HTMLElement>('[data-cosmos-focus]');
    if (focus && cosmos) {
      const rect = focus.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + scrollY + rect.height / 2;
      const vh = viewportHeight();
      cosmos.target.focusX = (cx - innerWidth / 2) / vh;
      cosmos.target.focusY = (vh / 2 - cy) / vh;
    }
  }

  let lastY = scrollY;
  let lastT = performance.now();

  function onScroll() {
    if (!cosmos) return;
    const max = Math.max(1, document.documentElement.scrollHeight - viewportHeight());
    cosmos.target.launch = hasLaunch ? Math.min(1, scrollY / launchEnd) : 1;
    cosmos.target.drift = scrollY / max;
    cosmos.target.after = Math.max(0, scrollY - (hasLaunch ? launchEnd : 0)) / viewportHeight();
    if (!motion.matches) {
      cosmos.renderOnce();
      return;
    }
    // Scroll velocity (px/ms) → warp boost. A fast flick (~8 px/ms) maxes it out.
    const now = performance.now();
    const velocity = Math.abs(scrollY - lastY) / Math.max(16, now - lastT);
    lastY = scrollY;
    lastT = now;
    const kick = Math.min(1, Math.max(0, (velocity - 1.2) / 6));
    cosmos.target.boost = Math.max(cosmos.target.boost, kick);
  }

  function onPointer(event: PointerEvent) {
    if (!cosmos || !finePointer.matches) return;
    cosmos.target.mouseX = (event.clientX / innerWidth) * 2 - 1;
    cosmos.target.mouseY = -((event.clientY / innerHeight) * 2 - 1);
  }

  if (cosmos) {
    cosmos.onFrame = updateTelemetry;
    addEventListener('scroll', onScroll, { passive: true });
    // Only re-measure on real layout changes (width/rotation), not the address bar.
    addEventListener('resize', () => {
      if (innerWidth === lastWidth) return;
      lastWidth = innerWidth;
      measure();
      onScroll();
    });
    addEventListener('pointermove', onPointer, { passive: true });

    document.addEventListener('astro:page-load', () => {
      lastY = scrollY; // navigation resets scroll; don't count it as velocity
      measure();
      cosmos.target.singularity = hasLaunch ? 1 : 0;
      onScroll();
      // On first load, appear in place instead of easing in from defaults.
      if (!canvas?.dataset.ready) {
        cosmos.snap();
        if (canvas) canvas.dataset.ready = 'true';
      }
      if (motion.matches) cosmos.start();
      else cosmos.renderOnce();
    });

    // WebKit (Safari) crashes when a view transition snapshots a live WebGL canvas. Take the
    // canvas out of the page for the few hundred milliseconds of a page transition there.
    const ua = navigator.userAgent;
    if (canvas && /AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg/.test(ua)) {
      const show = () => canvas.style.removeProperty('display');
      document.addEventListener('astro:before-preparation', () => {
        canvas.style.display = 'none';
      });
      document.addEventListener('astro:before-swap', (event) => {
        const transition = (event as Event & { viewTransition?: ViewTransition }).viewTransition;
        if (transition) void transition.finished.finally(show);
        else show();
        setTimeout(show, 1500); // safety net
      });
    }

    // The planet game covers the whole screen; no need to draw the sky behind it.
    addEventListener('cosmos:occluded', (event) => {
      if (!(event instanceof CustomEvent)) return;
      if (event.detail === true) cosmos.stop();
      else if (motion.matches) cosmos.start();
    });

    // Re-measure after fonts and images settle.
    void document.fonts.ready.then(() => {
      measure();
      onScroll();
    });
  }
</script>

<style>
  .cosmos {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    max-width: none;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
  }

  .cosmos[data-ready] {
    opacity: 1;
  }

  :global(.no-webgl) .cosmos {
    display: none;
  }
</style>
