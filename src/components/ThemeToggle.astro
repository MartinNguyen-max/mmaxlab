---
import Icon from './Icon.astro';
---

<button
  class="theme-toggle"
  type="button"
  aria-label="Light mode"
  aria-pressed="false"
  data-theme-toggle
>
  <Icon name="sun" class="icon-sun" size={18} />
  <Icon name="moon" class="icon-moon" size={18} />
</button>

<script>
  const STORAGE_KEY = 'theme';

  function sync(button: HTMLButtonElement) {
    const light = document.documentElement.dataset.theme === 'light';
    button.setAttribute('aria-pressed', String(light));
  }

  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!button) return;
    sync(button);
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      const apply = () => {
        root.dataset.theme = next;
        localStorage.setItem(STORAGE_KEY, next);
        sync(button);
      };
      // Circular reveal from the button, using a same-document view transition.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!document.startViewTransition || reduce) return apply();
      const rect = button.getBoundingClientRect();
      root.style.setProperty('--toggle-x', `${rect.left + rect.width / 2}px`);
      root.style.setProperty('--toggle-y', `${rect.top + rect.height / 2}px`);
      root.classList.add('theme-transition');
      const transition = document.startViewTransition(apply);
      void transition.finished.finally(() => root.classList.remove('theme-transition'));
    });
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .theme-toggle:hover {
    border-color: var(--c-line-strong);
    background: var(--c-line);
  }

  .theme-toggle :global(svg) {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur) var(--ease-out),
      rotate var(--dur-slow) var(--ease-out),
      scale var(--dur) var(--ease-out);
  }

  .theme-toggle[aria-pressed='false'] :global(.icon-moon),
  .theme-toggle[aria-pressed='true'] :global(.icon-sun) {
    opacity: 0;
    rotate: -90deg;
    scale: 0.5;
  }

  :global(.theme-transition::view-transition-old(root)),
  :global(.theme-transition::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }

  :global(.theme-transition::view-transition-new(root)) {
    animation: theme-reveal 700ms var(--ease-in-out);
  }

  @keyframes theme-reveal {
    from {
      clip-path: circle(0 at var(--toggle-x) var(--toggle-y));
    }
    to {
      clip-path: circle(150vmax at var(--toggle-x) var(--toggle-y));
    }
  }
</style>
