---
/**
 * A tiny drivable planet with one screen per live project.
 * Nothing heavy loads until you press Start: until then it's a blurred still of the planet.
 * Pressing Start loads three.js (prefetched on hover/touch) and enters a fullscreen play mode.
 * The project overview below covers the same content without the game.
 */
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import poster from '../assets/planet-poster.png';
import { sortProjects } from '../lib/projects';
import Icon from './Icon.astro';

const projects = sortProjects(await getCollection('projects'));
const live = await Promise.all(
  projects
    .filter((p) => p.data.status === 'live' && p.data.url)
    .map(async (p) => ({
      id: p.id,
      name: p.data.name,
      tagline: p.data.tagline,
      url: p.data.url ?? '',
      ...(p.data.image
        ? { image: (await getImage({ src: p.data.image, width: 1280, format: 'webp' })).src }
        : {}),
    })),
);
const lab = projects
  .filter((p) => p.data.status !== 'live')
  .map((p) => ({ name: p.data.name, tagline: p.data.tagline }));
const data = JSON.stringify({ live, lab });
---

<section id="planet" class="planet" aria-labelledby="planet-title" data-planet>
  <Image
    class="poster"
    src={poster}
    alt=""
    widths={[640, 960, 1280]}
    sizes="100vw"
    loading="lazy"
    aria-hidden="true"
  />
  <canvas
    class="planet-canvas"
    tabindex="-1"
    aria-label="Planet game. Drive with W A S D or the arrow keys, drag to look around, press Enter to open the project you are next to, Escape to leave."
    data-planet-canvas
  ></canvas>

  <header class="head">
    <p class="kicker">01 — Landing zone</p>
    <h2 id="planet-title">Take the rover for a spin</h2>
    <p class="intro">A tiny planet with a screen for every live project.</p>
  </header>

  <button class="btn btn-primary start" type="button" data-planet-start>
    <span class="spinner" aria-hidden="true"></span>
    <span data-start-label>Start driving</span>
  </button>

  <!-- Play mode UI -->
  <div class="topbar">
    <p class="hint hint-keys">
      <kbd>WASD</kbd> drive · drag to look · <kbd>Enter</kbd> open
    </p>
    <p class="hint hint-touch">Joystick · drag to look</p>
    <div class="tools">
      <button class="tool" type="button" data-planet-home aria-label="Back to the landing zone">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            d="M3 11.5 12 4l9 7.5M5.5 9.5V20h5v-6h3v6h5V9.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"
          ></path>
        </svg>
      </button>
      <button class="exit" type="button" data-planet-exit>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path
            d="M6 6l12 12M18 6 6 18"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
          ></path>
        </svg>
        Exit
      </button>
    </div>
  </div>

  <div class="card" data-planet-card aria-live="polite" hidden>
    <div class="card-body">
      <p class="card-title" data-card-title></p>
      <p class="card-text" data-card-text></p>
      <ul class="card-list" data-card-list hidden></ul>
    </div>
    <a class="btn btn-primary open" data-card-open href="/#projects" target="_blank" rel="noopener">
      <span data-card-label>Open</span>
      <Icon name="arrow-up-right" size={14} />
    </a>
    <button class="card-close" type="button" data-card-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path
          d="M6 6l12 12M18 6 6 18"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <div class="joystick" data-joystick aria-hidden="true">
    <span class="knob" data-joystick-knob></span>
  </div>

  <script type="application/json" data-planet-data set:html={data} />
</section>

<script>
  import type { PlanetHandle, mountPlanet } from '../scripts/planet/game';

  interface GameModule {
    mountPlanet: typeof mountPlanet;
  }
  let game: PlanetHandle | null = null;
  let loading: Promise<GameModule> | null = null;

  /** Fetch the game code once; also used to prefetch when a pointer approaches Start. */
  function load(): Promise<GameModule> {
    loading ??= import('../scripts/planet/game').catch((error: unknown) => {
      loading = null;
      throw error;
    });
    return loading;
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-planet]');
    const start = root?.querySelector<HTMLButtonElement>('[data-planet-start]');
    const label = root?.querySelector('[data-start-label]');
    if (!root || !start || !label || root.dataset.bound) return;
    root.dataset.bound = 'true';
    if (!document.createElement('canvas').getContext('webgl2')) {
      root.classList.add('no-webgl');
      return;
    }

    const prefetch = () => void load().catch(() => undefined);
    for (const type of ['pointerenter', 'pointerdown', 'focus']) {
      start.addEventListener(type, prefetch, { once: true, passive: true });
    }

    start.addEventListener('click', async () => {
      if (!game) {
        root.classList.add('is-loading');
        label.textContent = 'Loading planet…';
        try {
          const { mountPlanet } = await load();
          if (!root.isConnected) return;
          game = mountPlanet(root);
        } catch {
          label.textContent = 'Try again';
          return;
        } finally {
          root.classList.remove('is-loading');
        }
        if (!game) {
          root.classList.add('no-webgl');
          return;
        }
      }
      label.textContent = 'Keep driving';
      game.enter();
    });

    document.addEventListener(
      'astro:before-swap',
      () => {
        game?.destroy();
        game = null;
      },
      { once: true },
    );
  }

  // This module may run after the first astro:page-load has fired, so also run once now.
  // The data-bound guard makes the two calls safe.
  document.addEventListener('astro:page-load', init);
  init();
</script>

<style>
  .planet {
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 30rem;
    overflow: hidden;
    background: linear-gradient(180deg, #4f9ff0, #a9d6ff 60%, #eef8ff);
    color: #10233a;
    isolation: isolate;
    /* Fade in from the space scene above, so you "descend" onto the planet. */
    mask-image: linear-gradient(to bottom, transparent, #000 16%);
  }

  .poster {
    position: absolute;
    inset: -2%;
    width: 104%;
    height: 104%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 70%;
    filter: blur(6px) saturate(1.1);
    transition: opacity 600ms var(--ease-out);
  }

  .planet-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms var(--ease-out);
  }

  :global(.is-ready) .planet-canvas {
    opacity: 1;
  }

  :global(.is-ready) .poster {
    opacity: 0;
  }

  .head {
    position: absolute;
    top: var(--space-8);
    left: var(--gutter);
    right: var(--gutter);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease-out);
  }

  .head h2 {
    font-size: var(--fs-xl);
    letter-spacing: -0.05em;
    line-height: 0.95;
    text-wrap: balance;
    text-shadow: 0 1px 24px rgb(255 255 255 / 0.5);
  }

  .head .kicker {
    color: inherit;
    opacity: 0.85;
  }

  .intro {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.65);
    color: #10233a;
    font-size: var(--fs-sm);
    backdrop-filter: blur(8px);
  }

  .start {
    position: absolute;
    left: 50%;
    top: 58%;
    translate: -50% -50%;
    padding: var(--space-4) var(--space-8);
    font-size: var(--fs-md);
    box-shadow: 0 14px 44px -10px rgb(0 0 0 / 0.45);
    transition:
      opacity var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  /* Keep the centring: the global .btn:hover lift would otherwise replace this translate,
     making the button jump out from under the pointer. */
  .start:hover {
    translate: -50% calc(-50% - 2px);
    box-shadow: 0 18px 50px -8px color-mix(in oklab, var(--c-accent) 60%, transparent);
  }

  .spinner {
    display: none;
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }

  :global(.is-loading) .spinner {
    display: inline-block;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  :global(.no-webgl) .start {
    display: none;
  }

  /* ---------- Play mode: fullscreen, page scrolling paused ---------- */
  :global(html.planet-playing),
  :global(html.planet-playing body) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* <main> is its own stacking context (view transitions), so the game can't simply sit above
     the site header with z-index; hide the header and HUD while playing instead. */
  :global(html.planet-playing [data-telemetry]),
  :global(html.planet-playing .site-header) {
    visibility: hidden;
  }

  :global(.is-playing).planet {
    position: fixed;
    inset: 0;
    z-index: 1000;
    height: 100dvh;
    min-height: 0;
    mask-image: none;
    touch-action: none;
  }

  :global(.is-playing) .planet-canvas {
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
  }

  :global(.is-playing) .planet-canvas:active {
    cursor: grabbing;
  }

  :global(.is-playing) .head,
  :global(.is-playing) .start {
    opacity: 0;
    pointer-events: none;
  }

  .topbar,
  .joystick,
  .card {
    display: none;
  }

  :global(.is-playing) .topbar {
    position: absolute;
    top: max(var(--space-3), env(safe-area-inset-top));
    left: var(--space-3);
    right: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    pointer-events: none;
  }

  .hint {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: rgb(0 0 0 / 0.4);
    color: #fff;
    font-size: var(--fs-xs);
    backdrop-filter: blur(8px);
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.95em;
    opacity: 0.9;
  }

  .hint-touch {
    display: none;
  }

  @media (pointer: coarse) {
    .hint-keys {
      display: none;
    }

    .hint-touch {
      display: block;
    }
  }

  .tools {
    display: flex;
    gap: var(--space-2);
    pointer-events: auto;
  }

  .tool {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .tool:hover {
    background: rgb(0 0 0 / 0.6);
  }

  /* Leaving play mode must be obvious: a solid, labelled button. */
  .exit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-pill);
    background: #fff;
    color: #111;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.3);
  }

  .exit:hover {
    background: var(--c-accent-hot);
  }

  /* Compact info card: one row, top centre, never in the way of driving. */
  :global(.is-playing) .card:not([hidden]) {
    position: absolute;
    top: calc(max(var(--space-3), env(safe-area-inset-top)) + 3.5rem);
    left: 50%;
    translate: -50% 0;
    width: max-content;
    max-width: min(24rem, calc(100% - 2 * var(--space-3)));
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: var(--c-glass);
    color: var(--c-fg);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.4);
    animation: card-in 300ms var(--ease-out);
  }

  /* Component display rules (e.g. .btn's inline-flex) would otherwise override [hidden]. */
  .card [hidden] {
    display: none !important;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      translate: -50% -0.5rem;
    }
  }

  .card-body {
    min-width: 0;
  }

  .card-title {
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .card-text {
    overflow: hidden;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .card-list :global(li) {
    padding: 0 var(--space-2);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
  }

  .open {
    flex: none;
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-sm);
  }

  .card-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--c-muted);
    cursor: pointer;
  }

  /* Joystick, bottom right (the thumb's side), for touch screens. */
  @media (pointer: coarse) {
    :global(.is-playing) .joystick {
      position: absolute;
      right: max(var(--space-6), env(safe-area-inset-right));
      bottom: max(var(--space-8), env(safe-area-inset-bottom));
      display: grid;
      place-items: center;
      width: 8rem;
      height: 8rem;
      border: 2px solid rgb(255 255 255 / 0.6);
      border-radius: 50%;
      background: rgb(0 0 0 / 0.22);
      backdrop-filter: blur(6px);
      touch-action: none;
    }
  }

  .knob {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.3);
    pointer-events: none;
  }
</style>
