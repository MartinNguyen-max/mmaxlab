---
import { SITE } from '../config';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="mono">
      © {year} {SITE.author} · Aarhus, DK
    </p>
    <ul>
      <li>
        <a href={SITE.github}>
          <Icon name="github" size={16} /> GitHub
        </a>
      </li>
      <li>
        <a href={SITE.linkedin}>
          <Icon name="linkedin" size={16} /> LinkedIn
        </a>
      </li>
      <li>
        <a href={SITE.repo}>Source of this site</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    border-top: 1px solid var(--c-line);
    background: color-mix(in oklab, var(--c-bg) 70%, transparent);
    backdrop-filter: blur(10px);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  /* Leave room for the fixed telemetry HUD on wide screens. */
  @media (width >= 48rem) {
    .inner {
      padding-block-end: var(--space-24);
    }
  }

  p {
    color: var(--c-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-decoration: none;
    transition: color var(--dur-fast);
  }

  a:hover {
    color: var(--c-accent-ink);
  }
</style>
