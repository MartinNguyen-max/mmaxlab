---
/** Decorative flight HUD; values are written by the cosmos render loop. */
---

<div class="telemetry" aria-hidden="true" data-telemetry transition:persist="telemetry">
  <span>
    <span class="led"></span>
    <span data-t="phase">Standby</span>
  </span>
  <span>
    Vel <b data-t="vel">0.00c</b>
  </span>
  <span>
    Dist <b data-t="dist">0.0 ly</b>
  </span>
  <span data-t="time">T+00:00</span>
</div>

<style>
  .telemetry {
    position: fixed;
    left: var(--gutter);
    bottom: var(--space-4);
    z-index: 40;
    display: flex;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-pill);
    background: var(--c-glass);
    backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  b {
    font-weight: 500;
    color: var(--c-fg);
  }

  span {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    white-space: nowrap;
  }

  .led {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 10px var(--c-accent);
    animation: blink 1.6s steps(2, jump-none) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  @media (width < 48rem) {
    .telemetry {
      display: none;
    }
  }

  :global(.no-webgl) .telemetry {
    display: none;
  }
</style>
