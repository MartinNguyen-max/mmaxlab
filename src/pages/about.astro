---
import Icon from '../components/Icon.astro';
import Scramble from '../components/Scramble.astro';
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';

const toolbox = [
  { group: 'Languages', items: ['TypeScript', 'JavaScript', 'SQL', 'HTML & CSS'] },
  { group: 'Frontend', items: ['React', 'Next.js', 'Astro', 'Vite', 'Tailwind CSS'] },
  { group: 'Backend & data', items: ['Node.js', 'Supabase', 'PostgreSQL', 'Drizzle ORM'] },
  { group: 'Quality', items: ['Vitest', 'Playwright', 'ESLint', 'Biome'] },
  { group: 'Platform', items: ['Vercel', 'GitHub Actions', 'PWA'] },
  { group: 'AI', items: ['LLM APIs', 'RAG', 'Claude Code'] },
];
---

<BaseLayout
  title="About"
  description="MartinNguyen-Max is a software developer in Aarhus, Denmark, building web apps, games and AI tools."
>
  <article class="about container">
    <header class="intro">
      <p class="kicker reveal">
        <Scramble text="Crew file · 001" />
      </p>
      <h1 class="reveal" style="--d: 0.5">
        Hi, I'm <span class="accent">MartinNguyen-Max</span>.
      </h1>
      <div class="bio">
        <p class="reveal" style="--d: 1">
          I'm a software developer based in Aarhus, Denmark. I build web apps with TypeScript, React
          and Next.js, and I care about the details that make software feel good: speed,
          accessibility and clean code.
        </p>
        <p class="reveal" style="--d: 1.4">
          M.MaxLab is my workshop. It's where side projects become real products: a training
          dashboard for triathletes, a League of Legends draft game, and a growing list of AI tools
          that solve everyday problems for Danish businesses.
        </p>
      </div>
    </header>

    <section class="block" aria-labelledby="toolbox-title">
      <h2 id="toolbox-title" class="kicker reveal">
        Toolbox
      </h2>
      <dl class="toolbox">
        {toolbox.map((row, i) => (
          <div class="row reveal" style={`--d: ${i * 0.3}`}>
            <dt>{row.group}</dt>
            <dd>
              <ul class="tags">
                {row.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="block contact" aria-labelledby="contact-title">
      <h2 id="contact-title" class="kicker reveal">
        Open a channel
      </h2>
      <p class="reveal">The best way to reach me is LinkedIn. My code lives on GitHub.</p>
      <div class="actions reveal" style="--d: 0.6">
        <a class="btn btn-primary" href={SITE.linkedin}>
          <Icon name="linkedin" size={16} />
          LinkedIn
          <Icon name="arrow-up-right" size={16} />
        </a>
        <a class="btn" href={SITE.github}>
          <Icon name="github" size={16} />
          {SITE.githubUser}
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: var(--space-24);
    padding-block: calc(var(--header-h) + var(--space-24)) var(--space-24);
    max-width: 60rem;
  }

  .intro {
    display: grid;
    gap: var(--space-6);
  }

  h1 {
    font-size: var(--fs-2xl);
    letter-spacing: -0.06em;
    line-height: 0.9;
    overflow-wrap: anywhere;
  }

  .accent {
    background: linear-gradient(
      100deg,
      var(--c-accent-hot),
      var(--c-accent) 60%,
      var(--c-accent-deep)
    );
    background-clip: text;
    color: transparent;
  }

  .bio {
    display: grid;
    gap: var(--space-4);
    max-width: 58ch;
    font-size: var(--fs-md);
    color: var(--c-muted);
  }

  .block {
    display: grid;
    gap: var(--space-8);
  }

  .toolbox {
    display: grid;
    border-top: 1px solid var(--c-line);
  }

  .row {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--c-line);
  }

  @media (width >= 40rem) {
    .row {
      grid-template-columns: 12rem 1fr;
      align-items: center;
    }
  }

  dt {
    font-weight: 550;
  }

  dd {
    margin: 0;
  }

  .contact > p {
    font-size: var(--fs-md);
    color: var(--c-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
