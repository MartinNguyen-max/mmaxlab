---
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import LaunchSequence from '../components/LaunchSequence.astro';
import PlanetGame from '../components/PlanetGame.astro';
import ProjectList from '../components/ProjectList.astro';
import Scramble from '../components/Scramble.astro';
import { SITE } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Hero />
  <LaunchSequence />
  <PlanetGame />
  <ProjectList />

  <section class="outro container" aria-labelledby="outro-title">
    <p class="kicker reveal">
      <Scramble text="End of transmission" />
    </p>
    <h2 id="outro-title" class="reveal" style="--d: 0.5">
      Something new is always on the <span class="accent">launchpad</span>.
    </h2>
    <p class="reveal" style="--d: 1">
      Follow along on GitHub, or say hi on LinkedIn.
    </p>
    <div class="outro-actions reveal" style="--d: 1.5">
      <a class="btn btn-primary" href={SITE.github}>
        <Icon name="github" size={16} />
        {SITE.githubUser}
        <Icon name="arrow-up-right" size={16} />
      </a>
      <a class="btn" href={SITE.linkedin}>
        <Icon name="linkedin" size={16} />
        LinkedIn
      </a>
      <a class="btn" href="/about">
        About me
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .outro {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    padding-block: var(--space-16) var(--space-24);
    text-align: center;
  }

  .outro h2 {
    max-width: 16ch;
    font-size: var(--fs-2xl);
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .outro > p:not(.kicker) {
    font-size: var(--fs-md);
    color: var(--c-muted);
  }

  .accent {
    background: linear-gradient(
      100deg,
      var(--c-accent-hot),
      var(--c-accent) 60%,
      var(--c-accent-deep)
    );
    background-clip: text;
    color: transparent;
  }

  .outro-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
